
---
import "../styles/global.css";

interface Props {
  title: string;
}

const { title } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title} | Katelyn Codes ♡</title>

    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Playfair+Display:wght@500;600;700&display=swap"
      rel="stylesheet"
    />
  </head>

  <body>
    <header class="site-header">
      <a class="logo" href="/">katelyn codes ♡</a>

      <nav aria-label="Main navigation">
        <a href={import.meta.env.BASE_URL}>home</a>
        <a href={`${import.meta.env.BASE_URL}series/`}>series</a>
        <a href={`${import.meta.env.BASE_URL}resources/`}>resources</a>
        <a href={`${import.meta.env.BASE_URL}letters/`}>letters</a>
        <a href={`${import.meta.env.BASE_URL}about/`}>about</a>
      </nav>
    </header>

    <main class="page-container">
      <slot />
    </main>

    <footer>
      made with love & a little bit of code ♡
    </footer>
  </body>
</html>
