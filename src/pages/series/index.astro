
---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { getCollection } from "astro:content";

const series = (await getCollection("series")).sort(
  (a, b) => a.data.order - b.data.order
);

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");

const icons = ["♡", "⌘", "✳", "✧", "✦", "⚖", "☼"];
---

<BaseLayout title="The Series | Katelyn Codes">
  <div class="series-page">
    <div class="series-hero">
      <p class="eyebrow">THE KATELYN CODES EDIT ♡</p>
      <h1>seven series.<br /><em>endless curiosity.</em></h1>
      <p class="intro">
        A little something different every day.
        Coding projects, data science, research, AI,
        tech ethics, and everything in between.
        Pick your obsession ♡
      </p>
    </div>

    <div class="series-directory">
      {series.map((item) => (
        <a
          class="series-card"
          href={`${base}series/${item.id}/`}
        >
          <div class="card-top">
            <span>
              {item.data.day.toUpperCase()} / SERIES {String(item.data.order).padStart(2, "0")}
            </span>
            <span class="card-icon">{icons[item.data.order - 1]}</span>
          </div>

          <div class="card-middle">
            <h2>{item.data.title}</h2>
            <p>{item.data.description}</p>
          </div>

          <div class="card-bottom">
            <span>explore the series</span>
            <span aria-hidden="true">↗</span>
          </div>
        </a>
      ))}
    </div>
  </div>
</BaseLayout>

<style>
  .series-page {
    padding: 75px 0 100px;
  }

  .series-hero {
    max-width: 760px;
    margin-bottom: 55px;
  }

  .series-hero h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 1.12;
    margin: 16px 0 24px;
  }

  .series-hero h1 em {
    color: #a91939;
    font-weight: 400;
  }

  .series-hero .intro {
    color: #68565c;
    font-size: 18px;
    line-height: 1.8;
  }

  .series-directory {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 22px;
  }

  .series-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    min-height: 270px;
    padding: 28px;
    background: #fff9f8;
    border: 1px solid #e4b9c2;
    border-radius: 22px;
    color: #21191d;
    text-decoration: none;
    transition: transform 0.2s ease, box-shadow 0.2s ease,
      background 0.2s ease;
  }

  .series-card:hover {
    transform: translateY(-5px);
    background: #fceef0;
    box-shadow: 0 12px 28px rgba(169, 25, 57, 0.09);
  }

  .card-top,
  .card-bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 12px;
  }

  .card-top {
    color: #a91939;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.12em;
  }

  .card-icon {
    font-size: 30px;
    line-height: 1;
  }

  .card-middle {
    margin: 30px 0;
  }

  .card-middle h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(25px, 3vw, 36px);
    line-height: 1.2;
    margin: 0 0 14px;
  }

  .card-middle p {
    color: #68565c;
    line-height: 1.7;
    font-size: 14px;
    margin: 0;
  }

  .card-bottom {
    padding-top: 18px;
    border-top: 1px solid #e4b9c2;
    color: #a91939;
    font-size: 13px;
    font-weight: 700;
  }

  .card-bottom span:last-child {
    font-size: 22px;
  }

  @media (max-width: 650px) {
    .series-directory {
      grid-template-columns: 1fr;
    }

    .series-page {
      padding-top: 45px;
    }

    .series-card {
      min-height: 230px;
    }
  }
</style>
