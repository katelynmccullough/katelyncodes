
---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import { getCollection, render, type CollectionEntry } from "astro:content";

export async function getStaticPaths() {
  const projects = await getCollection("projects");

  return projects.map((project) => ({
    params: { slug: project.id },
    props: { project },
  }));
}

interface Props {
  project: CollectionEntry<"projects">;
}

const { project } = Astro.props;
const { Content } = await render(project);

const base = import.meta.env.BASE_URL.replace(/\/?$/, "/");
---

<BaseLayout title={`${project.data.title} | Katelyn Codes`}>
  <article class="detail-page">
    <a class="back-link" href={`${base}resources/projects/`}>
      ← back to my projects
    </a>

    <header class="detail-hero">
      <p class="eyebrow">MADE BY KATELYN ♡</p>
      <h1>{project.data.title}</h1>
      <p class="intro">{project.data.description}</p>

      <div class="meta-row">
        {project.data.status && <span>{project.data.status}</span>}
        {project.data.role && <span>{project.data.role}</span>}
      </div>

      <div class="tags">
        {project.data.techStack.map((tag) => (
          <span>{tag}</span>
        ))}
      </div>

      <div class="actions">
        <a href={project.data.githubUrl} target="_blank" rel="noopener noreferrer">
          view on GitHub ↗
        </a>
        {project.data.demoUrl && (
          <a href={project.data.demoUrl} target="_blank" rel="noopener noreferrer">
            live demo ↗
          </a>
        )}
      </div>
    </header>

    {project.data.image && (
      <img
        class="project-image"
        src={project.data.image}
        alt={`${project.data.title} screenshot`}
      />
    )}

    <section class="content-section">
      <h2>behind the build ♡</h2>
      <div class="markdown-content">
        <Content />
      </div>
    </section>

    <a class="back-link" href={`${base}resources/projects/`}>
      ← explore more projects
    </a>
  </article>
</BaseLayout>

<style>
  .detail-page { max-width: 900px; margin: 0 auto; padding: 60px 0 110px; }
  .back-link { color: #a91939; font-weight: 700; text-decoration: none; }
  .detail-hero { margin: 55px 0 50px; }
  .detail-hero h1 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: clamp(44px, 6vw, 76px);
    line-height: 1.12; margin: 16px 0 24px;
  }
  .intro { color: #68565c; font-size: 19px; line-height: 1.8; }
  .meta-row, .tags, .actions { display: flex; flex-wrap: wrap; gap: 10px; margin-top: 20px; }
  .meta-row span, .tags span {
    background: #f6e5e8; color: #a91939;
    padding: 8px 13px; border-radius: 100px; font-size: 12px; font-weight: 600;
  }
  .actions a {
    display: inline-block; background: #a91939; color: white;
    padding: 13px 20px; border-radius: 100px;
    text-decoration: none; font-size: 14px; font-weight: 700;
  }
  .project-image { width: 100%; border-radius: 20px; margin: 20px 0 35px; }
  .content-section {
    background: #fff9f8; border: 1px solid #f0d7dc;
    border-radius: 22px; padding: 35px; margin: 40px 0;
  }
  .content-section h2 {
    font-family: "Playfair Display", Georgia, serif;
    font-size: 32px; margin: 0 0 25px;
  }
  .markdown-content { line-height: 1.9; color: #342b30; overflow-wrap: anywhere; }
  .markdown-content :global(h2),
  .markdown-content :global(h3) {
    font-family: "Playfair Display", Georgia, serif;
    margin: 28px 0 12px;
  }
  .markdown-content :global(a) { color: #a91939; }
  .markdown-content :global(pre) {
    overflow-x: auto; padding: 18px;
    background: #f6e5e8; border-radius: 12px;
  }
  .markdown-content :global(img) { max-width: 100%; border-radius: 12px; }
  @media (max-width: 600px) {
    .content-section { padding: 22px; }
    .detail-page { padding-top: 40px; }
  }
</style>
