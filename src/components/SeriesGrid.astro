
---
import type { CollectionEntry } from "astro:content";
import VideoCard from "./VideoCard.astro";

interface Props {
  videos: CollectionEntry<"videos">[];
}

const { videos } = Astro.props;

const categories = [
  { day: 1, label: "Research Paper of the Week", icon: "✧" },
  { day: 2, label: "Fun Coding Project", icon: "⌘" },
  { day: 3, label: "Becoming a Tech Girlie", icon: "♡" },
  { day: 4, label: "Data Science Deep Dive", icon: "✳" },
  { day: 5, label: "AI Experiments", icon: "✦" },
  { day: 6, label: "Tech Ethics", icon: "⚖" },
  { day: 7, label: "AI & Tech News", icon: "☼" },
];
---

<div class="series-grid">
  {categories.map(({ day, label, icon }) => {
    const video = videos.find((item) => item.data.day === day);

    return video ? (
      <VideoCard video={video} />
    ) : (
      <div class="coming-soon-card">
        <div class="card-top">
          <span>EPISODE {String(day).padStart(2, "0")} / 07</span>
          <span>♡</span>
        </div>

        <div class="placeholder-art">
          <span class="placeholder-icon">{icon}</span>
          <span>something good is coming</span>
        </div>

        <div class="card-content">
          <span class="category">{label}</span>
          <h3>Coming soon ♡</h3>
          <p>A new episode is on its way. Stay tuned!</p>
          <span class="soon-label">not yet published ✧</span>
        </div>
      </div>
    );
  })}
</div>

<style>
  .series-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 24px;
    margin-top: 30px;
  }

  .coming-soon-card {
    display: flex;
    flex-direction: column;
    gap: 16px;
    padding: 20px;
    background: #fff9f8;
    border: 1px dashed #e4b9c2;
    border-radius: 20px;
  }

  .card-top {
    display: flex;
    justify-content: space-between;
    align-items: center;
    color: #a91939;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.08em;
  }

  .card-top span:last-child {
    font-size: 24px;
    line-height: 1;
  }

  .placeholder-art {
    min-height: 150px;
    background: #f6e5e8;
    border-radius: 12px;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    gap: 10px;
    color: #a91939;
    font-size: 14px;
    font-weight: 600;
  }

  .placeholder-icon {
    font-size: 40px;
  }

  .card-content {
    display: flex;
    flex-direction: column;
    flex: 1;
    gap: 12px;
  }

  .category {
    color: #a91939;
    font-size: 11px;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  h3 {
    margin: 0;
    font-family: "Playfair Display", Georgia, serif;
    font-size: 25px;
  }

  p {
    margin: 0;
    color: #68565c;
    font-size: 14px;
    line-height: 1.6;
  }

  .soon-label {
    margin-top: auto;
    padding-top: 10px;
    color: #a91939;
    font-size: 13px;
    font-weight: 700;
    opacity: 0.7;
  }

  @media (max-width: 900px) {
    .series-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 600px) {
    .series-grid {
      grid-template-columns: 1fr;
    }
  }
</style>
